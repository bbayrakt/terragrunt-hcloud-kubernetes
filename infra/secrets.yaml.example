# Example secrets file
# This file should be encrypted with SOPS before committing
# 
# To encrypt this file:
#   sops -e -i secrets.yaml
# 
# To edit the encrypted file:
#   sops secrets.yaml
# 
# To decrypt for viewing:
#   sops -d secrets.yaml

# Hetzner Cloud API Token
hcloud_token: "YOUR_HCLOUD_TOKEN_HERE"

# SeaweedFS / S3-Compatible Backend Configuration
seaweedfs_endpoint: "http://YOUR_SEAWEEDFS_ENDPOINT"
seaweedfs_access_key: "YOUR_SEAWEEDFS_ACCESS_KEY"
seaweedfs_secret_key: "YOUR_SEAWEEDFS_SECRET_KEY"

# Let's Encrypt / Cert Manager Configuration
acme_email: "admin@example.com"

# Gateway API Configuration
gateway_api_lb_name: "k8s-gateway"
gateway_api_domain: "example.com"

# External DNS / Cloudflare Configuration
# External DNS automatically creates DNS A records from Gateway API resources
cloudflare_api_token: "YOUR_CLOUDFLARE_API_TOKEN"

# GitHub Actions Runner Controller
github_config_url: "https://github.com/YOUR_ORG"
github_token: "YOUR_GITHUB_PAT"
# github_runner_group: "Default"

# ArgoCD GitOps repository -- either this repo's own URL (self-referencing monorepo) or
# a separate, dedicated repo. See docs/brainstorms/argocd-gitops-migration-requirements.md's
# 2026-08-01 amendment for the monorepo decision and rationale.
#
# Auth mode 1 (SSH deploy key, used with an SSH-form gitops_repo_url below):
gitops_repo_url: "git@github.com:YOUR_ORG/YOUR_GITOPS_REPO.git"
gitops_repo_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  YOUR_READ_ONLY_DEPLOY_KEY_HERE
  -----END OPENSSH PRIVATE KEY-----
#
# Auth mode 2 (alternative -- HTTPS username + password/PAT, used with an https:// gitops_repo_url;
# leave gitops_repo_ssh_private_key unset/empty when using this instead):
# gitops_repo_username: "YOUR_GITHUB_USERNAME"
# gitops_repo_password: "YOUR_PERSONAL_ACCESS_TOKEN"
#
# Auth mode 3 (alternative -- no credentials, for a public HTTPS repo): set gitops_repo_url to
# the https:// URL and omit all of the above.

# Platform-tier AGE private key for KSOPS (dedicated key, separate from this repo's own
# keys.txt/.sops.yaml key -- generate with `age-keygen`)
platform_sops_age_private_key: |
  AGE-SECRET-KEY-YOUR_PLATFORM_TIER_KEY_HERE

# Add additional secrets as needed
# example_secret: "value"
# database_password: "secure_password"
