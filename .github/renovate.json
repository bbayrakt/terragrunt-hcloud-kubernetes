{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "terraform",
    "terragrunt",
    "helm",
    "github-actions",
    "custom.regex"
  ],
  "terraform": {
    "fileMatch": [
      "infra/environments/staging/**/terragrunt.hcl",
      "infra/modules/karpenter/terraform.tf"
    ]
  },
  "terragrunt": {
    "fileMatch": [
      "infra/environments/staging/**/terragrunt.hcl"
    ]
  },
  "helm": {
    "fileMatch": [
      "platform/**/Chart.yaml",
      "apps/**/Chart.yaml"
    ]
  },
  "automerge": false,
  "schedule": [
    "before 9am on Monday"
  ],
  "labels": [
    "dependencies",
    "staging"
  ],
  "packageRules": [
    {
      "description": "Exclude production paths entirely \u2014 v1 staging-only scope",
      "matchFilePrefixes": [
        "infra/environments/production/"
      ],
      "enabled": false
    },
    {
      "description": "Group: Terraform provider version bumps",
      "matchDatasources": [
        "terraform-provider"
      ],
      "groupName": "Terraform providers",
      "groupSlug": "terraform-providers"
    },
    {
      "description": "Group: External module git-ref bump (kubernetes_module_version)",
      "matchDatasources": [
        "github-tags"
      ],
      "groupName": "External module ref",
      "groupSlug": "external-module-ref"
    },
    {
      "description": "Group: Terraform-managed Helm chart versions (helm_charts map + karpenter + external_dns)",
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "matchFilePrefixes": [
        "infra/environments/staging/"
      ],
      "groupName": "Terraform-managed Helm charts",
      "groupSlug": "terraform-helm-charts"
    },
    {
      "description": "Group: ArgoCD-managed Helm chart dependency versions (platform/*/Chart.yaml)",
      "matchDatasources": [
        "helm"
      ],
      "matchFilePrefixes": [
        "platform/",
        "apps/"
      ],
      "groupName": "ArgoCD-managed Helm charts",
      "groupSlug": "argocd-helm-charts"
    }
  ],
  "ignorePaths": [
    "infra/environments/production/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track kubernetes_module_version git ref in staging/env.hcl",
      "fileMatch": [
        "infra/environments/staging/env\\.hcl$"
      ],
      "matchStrings": [
        "kubernetes_module_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "hcloud-k8s/terraform-hcloud-kubernetes",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Track external_dns_version standalone input in staging/env.hcl",
      "fileMatch": [
        "infra/environments/staging/env\\.hcl$"
      ],
      "matchStrings": [
        "external_dns_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "external-dns",
      "registryUrlTemplate": "https://kubernetes-sigs.github.io/external-dns/",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Track karpenter_chart_version (OCI) in staging/env.hcl",
      "fileMatch": [
        "infra/environments/staging/env\\.hcl$"
      ],
      "matchStrings": [
        "karpenter_chart_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/paperclipinc/charts/karpenter-provider-hetzner",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track external-dns Helm chart version in helm_charts map",
      "fileMatch": [
        "infra/environments/staging/env\\.hcl$"
      ],
      "matchStrings": [
        "(?s)external-dns\\s*=\\s*\\{[^}]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*\\n"
      ],
      "depNameTemplate": "external-dns",
      "registryUrlTemplate": "https://kubernetes-sigs.github.io/external-dns/",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Track argo-cd Helm chart version in helm_charts map",
      "fileMatch": [
        "infra/environments/staging/env\\.hcl$"
      ],
      "matchStrings": [
        "(?s)argocd\\s*=\\s*\\{[^}]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*\\n"
      ],
      "depNameTemplate": "argo-cd",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Track Terragrunt version in CI workflow",
      "fileMatch": [
        "\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "TERRAGRUNT_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "gruntwork-io/terragrunt",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track SOPS version in CI workflow",
      "fileMatch": [
        "\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "SOPS_VERSION=\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "getsops/sops",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track Terraform version in CI workflow (setup-terraform with: terraform_version)",
      "fileMatch": [
        "\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "terraform_version:\\s*\"?(?<currentValue>[^\\s\"]+)"
      ],
      "depNameTemplate": "hashicorp/terraform",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "repositories": [
    "bbayrakt/terragrunt-hcloud-kubernetes"
  ]
}
